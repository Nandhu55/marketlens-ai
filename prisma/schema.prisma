generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PortfolioItem {
  id          String   @id @default(cuid())
  symbol      String
  name        String
  quantity    Float
  buyPrice    Float
  currentPrice Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WatchlistItem {
  id        String   @id @default(cuid())
  symbol    String
  name      String
  addedAt   DateTime @default(now())
}

model SearchHistory {
  id        String   @id @default(cuid())
  query     String
  searchedAt DateTime @default(now())
}

model AlertItem {
  id        String   @id @default(cuid())
  symbol    String
  type      String   // "price_above", "price_below", "rsi_above", "rsi_below", "volume_spike"
  value     Float
  triggered Boolean  @default(false)
  triggeredAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PredictionLog {
  id          String   @id @default(cuid())
  symbol      String
  price       Float
  prediction  String   // JSON of the prediction
  recommendation String
  confidence  Float
  createdAt   DateTime @default(now())
}